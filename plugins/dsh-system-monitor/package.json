{
  "name": "dsh-system-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "在输入框下方的 dock 里用进度条显示会话所在主机的 CPU、内存、显卡与显存占用。",
  "type": "module",
  "license": "MIT",
  "author": "abuluoshuai",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-monitor",
    "cpu",
    "memory",
    "gpu",
    "vram",
    "macos"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
